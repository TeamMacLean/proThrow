<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta name="viewport" content="width=device-width"/>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <title>Updated Request</title>
</head>

<body>
<img class="center" src="<%- baseURL %>/logo.png" style="max-width: 80px; margin-bottom:20px;">
<% if (locals.vpnModeHeader) { %>
<p class="center" style="background:#fff3cd; padding:8px;"><%= locals.vpnModeHeader %></p>
<% } %>
<h1 class="center">A request has been modified</h1>
<h2 class="center"><%= locals.request.janCode %></h2>
<%# `reason` says what actually changed. This mail is sent for edits, notes and
    assignments alike, and it used to announce a status change every time - so
    adding a note told the submitter their status had changed when it had not. %>
<p class="center"><%= locals.reason || 'The request details were updated.' %></p>
<p class="center">Current status: <span class="font-weight-bold">"<%= locals.request.status %>"</span></p>
<a class="center" href="<%- baseURL %>/request/<%= locals.request.id %>">View request on site</a>
</body>

</html>